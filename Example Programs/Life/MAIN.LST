000000r 2               ;; 1 byte copy from one address to another
000000r 2               ;;
000000r 2               ;; {PARAM} address of source value
000000r 2               ;; {PARAM} address of destination value
000000r 2               .macro COPY source, destination
000000r 2                   LDA source
000000r 2                   STA destination
000000r 2               .endmacro
000000r 2               
000000r 2               ;; 16 bit data copy from one address to another
000000r 2               ;;
000000r 2               ;; {PARAM} low-byte address of source 16 bit value
000000r 2               ;; {PARAM} low-byte address of destination 16 bit value
000000r 2               .macro COPY16 source, destination
000000r 2                   LDA source
000000r 2                   STA destination
000000r 2                   LDA source + 1
000000r 2                   STA destination + 1
000000r 2               .endmacro
000000r 2               
000000r 2               .macro COPY32 source, destination
000000r 2                   COPY16 source, destination
000000r 2                   COPY16 source + 2, destination + 2
000000r 2               .endmacro
000000r 2               
000000r 2               .macro COPYADDR addr, destination
000000r 2                   LDA #(<addr)
000000r 2                   STA destination
000000r 2                   LDA #(>addr)
000000r 2                   STA destination + 1
000000r 2               .endmacro
000000r 2               
000000r 2               .macro SWAP lhs, rhs
000000r 2               	LDA lhs
000000r 2               	LDX rhs
000000r 2               	STX lhs
000000r 2               	STA rhs
000000r 2               .endmacro
000000r 2               
000000r 2               .macro SWAP16 lhs, rhs
000000r 2               	SWAP lhs, rhs
000000r 2               	SWAP lhs + 1, rhs + 1
000000r 2               .endmacro
000000r 2               
000000r 2               .macro ADD16 addr, imm
000000r 2                   CLC
000000r 2                   LDA addr
000000r 2                   ADC #<(imm)
000000r 2                   STA addr
000000r 2                   LDA addr + 1
000000r 2                   ADC #>(imm)
000000r 2                   STA addr + 1
000000r 2               .endmacro
000000r 2               
000000r 2               ;; 16 bit ADC
000000r 2               ;;
000000r 2               ;; { PARAM } low-byte address of 16-bit value
000000r 2               ;; { PARAM } low-byte address of 16-bit value
000000r 2               ;; { PARAM } low-byte address of desired 16-bit result
000000r 2               .macro ADC16 lhs, rhs, result
000000r 2                   CLC
000000r 2                   LDA lhs
000000r 2                   ADC rhs
000000r 2                   STA result
000000r 2                   LDA lhs + 1
000000r 2                   ADC rhs + 1
000000r 2                   STA result + 1
000000r 2               .endmacro
000000r 2               
000000r 2               ;; 32 bit ADC
000000r 2               ;;
000000r 2               ;; { PARAM } low-byte address of 32-bit value
000000r 2               ;; { PARAM } low-byte address of 32-bit value
000000r 2               ;; { PARAM } low-byte address of desired 32-bit result
000000r 2               .macro ADC32 lhs, rhs, result
000000r 2                   CLC
000000r 2                   LDA lhs
000000r 2                   ADC rhs
000000r 2                   STA result
000000r 2                   LDA lhs + 1
000000r 2                   ADC rhs + 1
000000r 2                   STA result + 1
000000r 2                   LDA lhs + 2
000000r 2                   ADC rhs + 2
000000r 2                   STA result + 2
000000r 2                   LDA lhs + 3
000000r 2                   ADC rhs + 3
000000r 2                   STA result + 3
000000r 2               .endmacro
000000r 2               
000000r 2               ;; 16 bit SUB
000000r 2               ;;
000000r 2               ;; { PARAM } low-byte address of 16-bit value
000000r 2               ;; { PARAM } low-byte address of 16-bit value
000000r 2               ;; { PARAM } low-byte address of desired 16-bit result
000000r 2               .macro SBC16 lhs, rhs, result
000000r 2               	SEC
000000r 2               	LDA lhs
000000r 2               	SBC rhs
000000r 2               	STA result
000000r 2               	LDA lhs + 1
000000r 2               	SBC rhs + 1
000000r 2               	STA result + 1
000000r 2               .endmacro
000000r 2               
000000r 2               ;; 16 bit CMP where SR flags are correct
000000r 2               ;;
000000r 2               ;; { PARAM } low-byte address of 16 bit value
000000r 2               ;; { PARAM } low-byte address of 16 bit value
000000r 2               .macro CMP16 lhs, rhs
000000r 2               .local @Done
000000r 2                   SEC
000000r 2                   LDA lhs + 1
000000r 2                   SBC rhs + 1
000000r 2                   BNE @Done
000000r 2                   LDA lhs
000000r 2                   SBC rhs
000000r 2               @Done:
000000r 2               .endmacro
000000r 2               
000000r 2               ;; 16 bit INC
000000r 2               ;;
000000r 2               ;; {PARAM} low-byte address of 16-bit value
000000r 2               ;;
000000r 2               ;; NOTE: Caller can check for zero bit in SR as it will only be zero when _both_
000000r 2               ;; high and low bytes are zero
000000r 2               .macro INC16 addr
000000r 2               .local @NoWrap
000000r 2                   INC addr
000000r 2                   BNE @NoWrap
000000r 2                   INC addr + 1
000000r 2               @NoWrap:
000000r 2               .endmacro
000000r 2               
000000r 2               ;; 16 bit DEC
000000r 2               ;;
000000r 2               ;; {PARAM} low-byte address of 16-bit value
000000r 2               ;;
000000r 2               ;; NOTE: SR status is based on lower byte only
000000r 2               .macro DEC16 addr
000000r 2               .local @NoWrap
000000r 2                   LDA addr
000000r 2                   BNE @NoWrap
000000r 2                   DEC addr + 1
000000r 2               @NoWrap:
000000r 2                   DEC addr
000000r 2               .endmacro
000000r 2               
000000r 2               .macro ROL16 addr
000000r 2                   ROL addr
000000r 2                   ROL addr + 1
000000r 2               .endmacro
000000r 2               
000000r 2               .macro ROR16 addr
000000r 2                   ROR addr + 1
000000r 2                   ROR addr
000000r 2               .endmacro
000000r 2               
