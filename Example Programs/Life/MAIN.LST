000000r 2               .struct SpriteAttr
000000r 2                   yPos            .byte
000000r 2                   xPos            .byte
000000r 2                   patternIndex    .byte
000000r 2                   color           .byte       ; low nibble contains color. high bit contains EARLY_CLOCK
000000r 2               .endstruct
000000r 2               
000000r 2               SPRITE_ATTR_EARLY_CLOCK := %10000000
000000r 2               SPRITE_DISABLE_Y_POS    := $D0  ; set as Y pos to disable this sprite and ALL sprites after this index
000000r 2               
000000r 2               ; waits 2µs, the non-active display max wait time
000000r 2               ; these routines are based on 3.6874Mhz so each cycle is just over .25µs
000000r 2               ; each NOP is 2 cycles. at ~3.6Mhz, NOP is .5µs
000000r 2               .macro VDPWait
000000r 2                   NOP
000000r 2                   NOP
000000r 2                   NOP
000000r 2                   NOP
000000r 2               .endmacro
000000r 2               
000000r 2               ; imm is an optional immediate value. if not provided, it's assumed data is already in A
000000r 2               .macro VDPRegisterSet register, imm
000000r 2               .ifnblank imm
000000r 2                   LDA #(imm)
000000r 2               .endif
000000r 2                   STA VDP_BASE+REGISTERS
000000r 2                   VDPWait
000000r 2                   LDA #(register) | REG_WR
000000r 2                   STA VDP_BASE+REGISTERS
000000r 2                   VDPWait
000000r 2               .endmacro
000000r 2               
000000r 2               .macro VDPVramAddrSet addr, isWrite
000000r 2                   LDA #<(addr)
000000r 2                   STA VDP_BASE+REGISTERS
000000r 2               .if isWrite
000000r 2                   LDA #>(addr) | VRAM_WR
000000r 2               .else
000000r 2                   LDA #>(addr)
000000r 2               .endif
000000r 2                   STA VDP_BASE+REGISTERS
000000r 2               .endmacro
000000r 2               
000000r 2               ; byte to send to VRAM should be in A
000000r 2               .macro VDPVramPut
000000r 2                   STA VDP_BASE+VRAM
000000r 2                   VDPWait
000000r 2               .endmacro
000000r 2               
000000r 2               ; read byte from VRAM and put in A
000000r 2               .macro VDPVramGet
000000r 2                   LDA VDP_BASE+VRAM
000000r 2                   VDPWait
000000r 2               .endmacro
000000r 2               
000000r 2               .endif
000000r 2               
