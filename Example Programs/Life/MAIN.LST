000000r 1               .org $0600
000600  1               
000600  1               .feature string_escapes
000600  1               
000600  1               ; constants
000600  1               FRAMES_PER_GEN  := 20   ; comparator for number of frames per generation
000600  1               
000600  1               ; zero page locations
000600  1               Gens        := $A0  ; 16 bit counter for the calculated generation
000600  1               
000600  1               ; Board and Frame buffer state
000600  1               ; For the GameLoop, `BoardCurr` signifies the _currently displayed_ board. which means
000600  1               ; that calculations, copies, etc. should happen on the _opposite_ board/framebuffer!
000600  1               ; For the FrameInterrupt, it will treat this value as the one to set the nametable to!
000600  1               BoardCurr   := $A2  ; 0 if BoardA, non-zero if BoardB
000600  1               FrameCount  := $A3  ; current frame count
000600  1               CalcNextGen := $A4  ; non-zero if the next generation calc is in progress, 0 if complete
000600  1               
000600  1               ; RAM locations for our 2 boards which are both 32 * 22 boards
000600  1               ; with an extra 1 cell "dead" border all around (34 * 24)
000600  1               ; each cell is a byte with current nonzero being alive, zero being dead
000600  1               BoardA      := $8000
000600  1               BoardB      := $9000
000600  1               
000600  1               ; VRAM locations for various tables
000600  1               PatternTable        := VDP_PATTERN_TABLE_START
000600  1               SpriteAttributes    := $0800
000600  1               ColorTable          := $1400
000600  1               SpritePatterns      := $2000
000600  1               FrameBufA           := $3000
000600  1               FrameBufB           := $3400
000600  1               
000600  1               ; Offsets for cardinal directions in our 34 * 24 board from top left corner
000600  1               CELL_OFFSET := -35
000600  1               NW  := 0    ; nw corner
000600  1               N   := 1    ; n cell
000600  1               NE  := 2    ; ne corner
000600  1               E   := 36   ; e cell
000600  1               SE  := 70   ; se corner
000600  1               S   := 69   ; s cell
000600  1               SW  := 68   ; sw corner
000600  1               W   := 34   ; w cell
000600  1               C   := 35   ; center, the cell itself
000600  1               
000600  1               ; sets VRAM address and then copies all bytes from start to end to vram
000600  1               .macro VDPInitTable vramAddr, ramStart, ramEnd
000600  1                   VDPVramAddrSet  vramAddr, 1
000600  1                   COPYADDR    ramStart, r0
000600  1                   COPYADDR    (ramEnd - ramStart), r1
000600  1                   JSR VDPVramPutN
000600  1               .endmacro
000600  1               
