000000r 2               
000000r 2               .macro DUART_BYTE_AVAIL
000000r 2               .local @Done
000000r 2                   SEC                 ; no byte available by default
000000r 2                   LDA DUART_BASE+SRA
000000r 2                   BIT #(SR_RX_RDY)
000000r 2                   BEQ @Done           ; no byte available
000000r 2                   CLC                 ; byte is available
000000r 2               @Done:
000000r 2               .endmacro
000000r 2               
000000r 2               .macro DUART_IRQ_ENABLE
000000r 2                   LDA #(IMR_CT_ENABLE)
000000r 2                   STA DUART_BASE+IMR
000000r 2               .endmacro
000000r 2               
000000r 2               .macro DUART_IRQ_DISABLE
000000r 2                   LDA #$00
000000r 2                   STA DUART_BASE+IMR
000000r 2               .endmacro
000000r 2               
000000r 2               ; register offsets for the DUART.
000000r 2               ; Registers marked with `(~RD)` are accessed on a read of that address
000000r 2               ; Registers marked with `(~WR)` are accessed on a write of that address
000000r 2               ; Registers marked with `(R/W)` are read-write and accessed on either
000000r 2               
000000r 2               MRA         := $00 ; mode register, channel A (R/W)
000000r 2               
000000r 2               SRA         := $01 ; status register, channel A (~RD)
000000r 2               CSRA        := SRA ; clock select register, channel A (~WR)
000000r 2               
000000r 2               ; NOTE: a ~RD at $02 is `reserved` and could have undesired effects
000000r 2               CRA         := $02 ; command register, channel A (~WR)
000000r 2               
000000r 2               RxFIFOA     := $03 ; Rx holding register, channel A (~RD)
000000r 2               TxFIFOA     := RxFIFOA ; Tx holding register, channel A (~WR)
000000r 2               
000000r 2               IPCR        := $04 ; input port change register (~RD)
000000r 2               ACR         := IPCR ; auxiliary control register (~WR)
000000r 2               
000000r 2               ISR         := $05 ; interrupt status register (~RD)
000000r 2               IMR         := ISR ; interrupt mask register (~WR)
000000r 2               
000000r 2               CTU         := $06 ; counter/timer register, upper (~RD)
000000r 2               CTPU        := CTU ; counter/timer preset register, upper (~WR)
000000r 2               
000000r 2               CTL         := $07 ; counter/timer register, lower (~RD)
000000r 2               CTPL        := CTL ; counter/timer preset register, lower (~WR)
000000r 2               
000000r 2               MISC        := $0C ; miscellaneous do what you want with it register (R/W)
000000r 2               
000000r 2               IPR         := $0D ; input port register (~RD)
000000r 2               OPCR        := IPR ; output port configuration register (~WR)
000000r 2               
000000r 2               CTR_STRT    := $0E ; counter/timer start (~RD)
000000r 2               SOPR        := CTR_STRT ; set output bits register (~WR)
000000r 2               
000000r 2               CTR_STOP    := $0F ; counter/timer stop (~RD)
000000r 2               ROPR        := CTR_STOP ; reset output bits register (~WR)
000000r 2               
000000r 2               ; ACR masks
000000r 2               ACR_TIMER_XTL_CLK   := (%110) << 4    ; timer-mode, use external clock unchanged
000000r 2               ACR_BRG_SELECT      := 1 << 7         ; select the 2nd group of BRG values
000000r 2               
000000r 2               ; IRQ masks
000000r 2               IMR_TX_RDY_A            := %00000001
000000r 2               IMR_RX_RDY_A            := %00000010
000000r 2               IMR_CT_ENABLE           := %00001000
000000r 2               
000000r 2               ; MR options
000000r 2               MR0_RX_WATCHDOG         := %10000000
000000r 2               MR0_FIFO_16             := %00001000
000000r 2               MR0_FIFO_RX_INT         := %01000000  ; bit 1 of Rx fifo interrupt level
000000r 2               
000000r 2               MR0_BAUD_NORMAL         := %000       ; use normal baud rate table
000000r 2               MR0_BAUD_EXT1           := %001       ; use extended 1 baud rate table
000000r 2               MR0_BAUD_EXT2           := %100       ; use extended 2 baud rate table
000000r 2               
000000r 2               MR1_RX_USE_RTS          := %10000000  ; receiver should use RTS control
000000r 2               MR1_FIFO_RX_INT         := %01000000  ; bit 2 of Rx fifo interrupt level
000000r 2               MR1_PARITY_MODE_NONE    := %10 << 3   ; no parity
000000r 2               MR1_BITS_PER_CHAR_8     := %11        ; 8 bits per character
000000r 2               
000000r 2               MR2_CHANNEL_MODE_NORMAL := %00 << 6   ; normal channel mode
000000r 2               MR2_CHANNEL_MODE_ECHO   := %01 << 6   ; echo mode
000000r 2               MR2_TX_USE_RTS          := %00100000  ; TX should use RTS control
000000r 2               MR2_TX_USE_CTS          := %00010000  ; TX should use CTS control
000000r 2               MR2_STOP_BITS_1         := %00000111  ; 1.0 stop bits
000000r 2               
000000r 2               ; SR masks
000000r 2               SR_RX_RDY               := %00000001  ; a char has been received
000000r 2               SR_RX_FULL              := %00000010  ; the receive FIFO is full
000000r 2               SR_TX_RDY               := %00000100  ; a char can be added to Tx fifo
000000r 2               SR_TX_EMPTY             := %00001000  ; Tx fifo is empty
000000r 2               
000000r 2               ; CR options and commands
000000r 2               CR_RX_ENABLE            := %00000001
000000r 2               CR_RX_DISABLE           := %00000010
000000r 2               CR_TX_ENABLE            := %00000100
000000r 2               CR_TX_DISABLE           := %00001000
000000r 2               
000000r 2               CR_COMMAND_NOP          := %0000 << 4 ; nop
000000r 2               CR_COMMAND_MR_1         := %0001 << 4 ; reset MR pointer to MR1
000000r 2               CR_COMMAND_RX_RES       := %0010 << 4 ; reset receiver. Rx disabled and FIFO is flushed
000000r 2               CR_COMMAND_TX_RES       := %0011 << 4 ; reset transmitter
000000r 2               CR_COMMAND_ERR_RES      := %0100 << 4 ; reset error status. clears all error statuses (break, parity, etc.)
000000r 2               CR_COMMAND_BRK_IRQ_RES  := %0101 << 4 ; reset break change interrupt
000000r 2               CR_COMMAND_BRK_STRT     := %0110 << 4 ; force TxD low. Tx must be active to be accepted
000000r 2               CR_COMMAND_BRK_STP      := %0111 << 4 ; force TxD high
000000r 2               CR_COMMAND_RTS_SET      := %1000 << 4 ; assert ~RTS (take low)
000000r 2               CR_COMMAND_RTS_RES      := %1001 << 4 ; negate ~RTS (take high)
000000r 2               CR_COMMAND_TO_MODE_ON   := %1010 << 4 ; turn timeout mode on (read docs for details)
000000r 2               CR_COMMAND_MR_0         := %1011 << 4 ; sets MR pointer to MR0
000000r 2               CR_COMMAND_TO_MODE_OFF  := %1100 << 4 ; turn timeout mode off (read docs for details)
000000r 2               CR_COMMAND_UNUSED       := %1101 << 4 ; not used so don't use it!
000000r 2               CR_COMMAND_PWR_DOWN_ON  := %1110 << 4 ; turn power-down mode on. ONLY AVAILABLE ON CHANNEL A
000000r 2               CR_COMMAND_PWR_DOWN_OFF := %1111 << 4 ; turn power-down mode off. ONLY AVAILABLE ON CHANNEL A
000000r 2               
000000r 2               ; OPCR masks
000000r 2               
000000r 2               
000000r 2               .endif
