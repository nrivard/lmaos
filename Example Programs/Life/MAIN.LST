000000r 2               .endmacro
000000r 2               
000000r 2               .macro LSR32 addr
000000r 2                   LSR addr + 3
000000r 2                   ROR addr + 2
000000r 2                   ROR addr + 1
000000r 2                   ROR addr
000000r 2               .endmacro
000000r 2               
000000r 2               ;; -A (negate accumulator)
000000r 2               .macro NEG ignored ; allow a param to so you can write `NEG A` but it's ignored. only operates on A
000000r 2                   EOR #$FF
000000r 2                   INC A
000000r 2               .endmacro
000000r 2               
000000r 2               ;; Invert the carry bit. destroys `A`, and N, Z flags
000000r 2               .macro INVC
000000r 2                   ROL A
000000r 2                   EOR #$01
000000r 2                   ROR A
000000r 2               .endmacro
