000A0E  1               GameLoop:
000A0E  1  78               SEI
000A0F  1  38 AD C1 BF      DUART_BYTE_AVAIL
000A13  1  89 01 F0 01  
000A17  1  18           
000A18  1  B0 07            BCS @AdvanceGame
000A1A  1  20 3B C0         JSR SerialGetByte
000A1D  1  C9 1B            CMP #(ASCII_ESCAPE)
000A1F  1  F0 14            BEQ @Done
000A21  1               @AdvanceGame:
000A21  1  58               CLI
000A22  1  CB               WAI
000A23  1  C6 A6            DEC FrameCount
000A25  1  D0 E7            BNE GameLoop
000A27  1  A9 3C            LDA #FRAMES_PER_GEN
000A29  1  85 A6            STA FrameCount
000A2B  1               @NextGen:
000A2B  1  78               SEI
000A2C  1  E6 A0 D0 02      INC16 GenCalc
000A30  1  E6 A1        
000A32  1  58               CLI
000A33  1  80 D9            BRA GameLoop
000A35  1               @Done:
000A35  1  58               CLI
000A36  1  60               RTS
000A37  1               
000A37  1               CalcGenerationsText:
000A37  1  A5 A3            LDA GenRndr + 1
000A39  1  20 A5 CB         JSR ByteToHexString
000A3C  1  A5 0E 85 C0      COPY16 r7, GenASCII_Hi
000A40  1  A5 0F 85 C1  
000A44  1  A5 A2            LDA GenRndr
000A46  1  20 A5 CB         JSR ByteToHexString
000A49  1  A5 0E 85 C2      COPY16 r7, GenASCII_Lo
000A4D  1  A5 0F 85 C3  
000A51  1  60               RTS
000A52  1               
000A52  1               ; clobbers r0 and r1 bc VDPVramPutN clobbers them
000A52  1               ; game loop should choose 2 different 16 bit registers to use if it needs them
000A52  1               FrameInterrupt:
000A52  1  48               PHA
000A53  1  DA               PHX
000A54  1  5A               PHY
000A55  1  2C 81 BF         BIT VDP_BASE+REGISTERS      ; clear IRQ request
000A58  1  38 A5 A3 E5      CMP16 GenRndr, GenCalc
000A5C  1  A1 D0 04 A5  
000A60  1  A2 E5 A0     
000A63  1  D0 03            BNE @NextGen
000A65  1  4C EA 0A         JMP @Done
000A68  1               @NextGen:
000A68  1  A5 A0 85 A2      COPY16 GenCalc, GenRndr
000A6C  1  A5 A1 85 A3  
000A70  1  A9 20 8D 81      VDPVramAddrSet (FrameBufA+32), 1
000A74  1  BF A9 70 8D  
000A78  1  81 BF        
000A7A  1  A5 A4            LDA BoardCurr
000A7C  1  D0 0A            BNE @BoardB
000A7E  1  A9 23 85 00      COPYADDR (BoardA+35), r0
000A82  1  A9 80 85 01  
000A86  1  80 08            BRA @BoardSet
000A88  1               @BoardB:
000A88  1  A9 23 85 00      COPYADDR (BoardB+35), r0
000A8C  1  A9 90 85 01  
000A90  1               @BoardSet:
000A90  1  A9 20 85 02      COPYADDR 32, r1
000A94  1  A9 00 85 03  
000A98  1  A2 16            LDX #22         ; 22 rows of board data
000A9A  1               @NextGenLoop:
000A9A  1  20 D6 C0         JSR VDPVramPutN
000A9D  1  18 A5 00 69      ADD16 r0, 2    ; next row, skipping dead border
000AA1  1  02 85 00 A5  
000AA5  1  01 69 00 85  
000AAA  1  A9 20 85 02      COPYADDR 32, r1
000AAE  1  A9 00 85 03  
000AB2  1  CA               DEX
000AB3  1  D0 E5            BNE @NextGenLoop
000AB5  1               @GenerationsText:
000AB5  1  20 37 0A         JSR CalcGenerationsText
000AB8  1  A9 E0 8D 81      VDPVramAddrSet (FrameBufA+(32 * 23)), 1
000ABC  1  BF A9 72 8D  
000AC0  1  81 BF        
000AC2  1  EA EA EA EA      VDPWait
000AC6  1  A5 C0            LDA GenASCII_Hi + 0
000AC8  1  8D 80 BF EA      VDPVramPut
000ACC  1  EA EA EA     
000ACF  1  A5 C1            LDA GenASCII_Hi + 1
000AD1  1  8D 80 BF EA      VDPVramPut
000AD5  1  EA EA EA     
000AD8  1  A5 C2            LDA GenASCII_Hi + 2
000ADA  1  8D 80 BF EA      VDPVramPut
000ADE  1  EA EA EA     
000AE1  1  A5 C3            LDA GenASCII_Hi + 3
000AE3  1  8D 80 BF EA      VDPVramPut
000AE7  1  EA EA EA     
000AEA  1               @Done:
000AEA  1  7A               PLY
000AEB  1  FA               PLX
000AEC  1  68               PLA
000AED  1  40               RTI
000AEE  1               
000AEE  1               ; Zeroes out game board memory (dead) and then copies initial state to game board A
000AEE  1               GameInit:
000AEE  1  A9 00 85 A2      COPYADDR 0, GenRndr
000AF2  1  A9 00 85 A3  
000AF6  1  A9 00 85 A0      COPYADDR 0, GenCalc
000AFA  1  A9 00 85 A1  
000AFE  1  64 A4            STZ BoardCurr               ; BoardA
000B00  1               @BoardA:
000B00  1  A9 00 85 00      COPYADDR BoardA, r0
000B04  1  A9 80 85 01  
000B08  1  A0 04            LDY #4
000B0A  1  A2 00            LDX #0                      ; 34 * 24 = 816 which is 4 * 204
000B0C  1               @BoardALoop:
000B0C  1  A9 00            LDA #0
000B0E  1  92 00            STA (r0)
000B10  1  E6 00 D0 02      INC16 r0
000B14  1  E6 01        
000B16  1  E8               INX
000B17  1  E0 CC            CPX #204
000B19  1  D0 F1            BNE @BoardALoop
000B1B  1  88               DEY
000B1C  1  D0 EE            BNE @BoardALoop
000B1E  1               @BoardB:
000B1E  1  A9 00 85 00      COPYADDR BoardB, r0
000B22  1  A9 90 85 01  
000B26  1  A0 04            LDY #4
000B28  1  A2 00            LDX #0
000B2A  1               @BoardBLoop:
000B2A  1  A9 00            LDA #0
000B2C  1  92 00            STA (r0)
000B2E  1  E6 00 D0 02      INC16 r0
000B32  1  E6 01        
000B34  1  E8               INX
000B35  1  E0 CC            CPX #204
000B37  1  D0 F1            BNE @BoardBLoop
000B39  1  88               DEY
000B3A  1  D0 EE            BNE @BoardBLoop
000B3C  1               @CopyState:
000B3C  1  A9 35 85 00      COPYADDR (NamesStart+32), r0  ; 2nd row of names table is initial state
000B40  1  A9 06 85 01  
000B44  1  A9 23 85 02      COPYADDR (BoardA+35), r1      ; skip entire top row (34) + 1st cell (border)
000B48  1  A9 80 85 03  
000B4C  1  A2 16            LDX #22                     ; 22 rows of data
000B4E  1  A0 00            LDY #0
000B50  1               @CopyStateLoop:
000B50  1  B1 00            LDA (r0), Y
000B52  1  91 02            STA (r1), Y
000B54  1  C8               INY
000B55  1  C0 20            CPY #32
000B57  1  D0 F7            BNE @CopyStateLoop
000B59  1  18 A5 00 69      ADD16 r0, 32
000B5D  1  20 85 00 A5  
000B61  1  01 69 00 85  
000B66  1  18 A5 02 69      ADD16 r1, 34
000B6A  1  22 85 02 A5  
000B6E  1  03 69 00 85  
000B73  1  CA               DEX
000B74  1  D0 DA            BNE @CopyStateLoop
000B76  1               @Done:
000B76  1  60               RTS
