0009B4  1  A9 0A 85 EE  
0009B8  1  A9 3C            LDA #FRAMES_PER_GEN                         ; setup our frame counter
0009BA  1  85 A6            STA FrameCount
0009BC  1               @EnableDisplay:
0009BC  1  2C 81 BF         BIT VDP_BASE+REGISTERS                      ; clear INT line
0009BF  1  A9 E0 8D 81      VDPRegisterSet CONTROL_2, (CONTROL_2_VRAM_16K | CONTROL_2_DISP_EN | CONTROL_2_INT_EN | CONTROL_2_MODE_GFX_1)
0009C3  1  BF EA EA EA  
0009C7  1  EA A9 81 8D  
0009D1  1  58               CLI
0009D2  1               @StartGame:
0009D2  1  20 0E 0A         JSR GameLoop
0009D5  1               @RestoreIRQ:
0009D5  1  78               SEI
0009D6  1  2C 81 BF         BIT VDP_BASE+REGISTERS                      ; clear INT line
0009D9  1  A9 00 8D 81      VDPRegisterSet CONTROL_1, (CONTROL_1_MODE_TEXT)
0009DD  1  BF EA EA EA  
0009E1  1  EA A9 80 8D  
0009EB  1  A9 90 8D 81      VDPRegisterSet CONTROL_2, (CONTROL_2_VRAM_16K | CONTROL_2_MODE_TEXT)    ; turn off INTs and display
0009EF  1  BF EA EA EA  
