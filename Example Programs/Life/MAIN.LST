000939  1  A2 0B            LDX #>(RegisterTable)
00093B  1  20 77 C0         JSR VDPInit
00093E  1  20 91 C0         JSR VDPClearVRAM
000941  1  20 AD C0         JSR VDPCopyDefaultCharset                   ; use default charset and overwrite $0 and $1 patterns
000944  1  A9 00 8D 81      VDPInitTable PatternTable, PatternsStart, PatternsEnd
000948  1  BF A9 40 8D  
