000000r 1               .include "vdp.inc"
000000r 2               ; LmaOS
000000r 2               ;
000000r 2               ; Copyright Nate Rivard 2023
000000r 2               
000000r 2               .ifndef VDP_INC
000000r 2               VDP_INC = 1
000000r 2               
000000r 2               VDP_BASE := N8BUS_PORT2
000000r 2               
000000r 2               ; this is the color carrier frequency that the VDP outputs
000000r 2               VDPClockHz      :=  3579545
000000r 2               
000000r 2               ; default VRAM locations
000000r 2               VDP_NAME_TABLE_START := $0800
000000r 2               VDP_PATTERN_TABLE_START := $0000
000000r 2               
000000r 2               ; register offsets for the VDP
000000r 2               VRAM            := $0
000000r 2               REGISTERS       := $1                   ; writing: 8 registers accessible. reading: status register is available
000000r 2               
000000r 2               ; Register masks
000000r 2               REG_WR          := $80                  ; used to write to a register
000000r 2               VRAM_WR         := $40                  ; used to write to vram
000000r 2               
000000r 2               ; Register indices
000000r 2               CONTROL_1       := $0
000000r 2               CONTROL_2       := $1
000000r 2               NAME_TABLE      := $2
000000r 2               COLOR_TABLE     := $3
000000r 2               PATTERN_TABLE   := $4
000000r 2               SPR_ATTR_TABLE  := $5
000000r 2               SPR_PTRN_TABLE  := $6
000000r 2               TEXT_COLOR      := $7
000000r 2               
000000r 2               ; control register 1 masks
000000r 2               CONTROL_1_MODE_GFX_1    := %0 << 1
000000r 2               CONTROL_1_MODE_GFX_2    := %1 << 1
000000r 2               CONTROL_1_MODE_MULTI    := %0 << 1
000000r 2               CONTROL_1_MODE_TEXT     := %0 << 1
000000r 2               
000000r 2               ; control register 2 masks
000000r 2               CONTROL_2_MODE_GFX_1    := %00 << 3
000000r 2               CONTROL_2_MODE_GFX_2    := %00 << 3
000000r 2               CONTROL_2_MODE_MULTI    := %01 << 3
000000r 2               CONTROL_2_MODE_TEXT     := %10 << 3
000000r 2               
000000r 2               CONTROL_2_VRAM_16K      := %10000000
000000r 2               CONTROL_2_DISP_EN       := %01000000
000000r 2               CONTROL_2_INT_EN        := %00100000
000000r 2               CONTROL_2_SPR_SIZE_2X   := %00000010
000000r 2               CONTROL_2_SPR_ZOOM      := %00000001
000000r 2               
000000r 2               ; table start multipliers. Divide your intended VRAM address by these
000000r 2               ; to get the appropriate register values
000000r 2               NAME_TABLE_MULT         := $0400
000000r 2               COLOR_TABLE_MULT        := $0040
000000r 2               PATTERN_TABLE_MULT      := $0800
000000r 2               SPR_ATTR_TABLE_MULT     := $0080
000000r 2               SPR_PATTERN_TABLE_MULT  := $0800
000000r 2               
000000r 2               ; status register masks
000000r 2               STATUS_FRAME_FLAG       := %10000000
000000r 2               STATUS_SPR_5TH          := %01000000
000000r 2               STATUS_SPR_COLLISION    := %00100000
000000r 2               STATUS_5TH_SPR_NUM      := %00011111            ; ANDing STATUS with this mask will give you the index to the 5th sprite (not displayed)
000000r 2               
000000r 2               ; colors :)
000000r 2               COLOR_CLR       := $0
000000r 2               COLOR_BLK       := $1
000000r 2               COLOR_GRN_MED   := $2
000000r 2               COLOR_GRN_LT    := $3
000000r 2               COLOR_BLU_DK    := $4
000000r 2               COLOR_BLU_LT    := $5
000000r 2               COLOR_RED_DK    := $6
000000r 2               COLOR_CYAN      := $7
000000r 2               COLOR_RED_MED   := $8
000000r 2               COLOR_RED_LT    := $9
000000r 2               COLOR_YEL_DK    := $A
000000r 2               COLOR_YEL_LT    := $B
000000r 2               COLOR_GRN_DK    := $C
000000r 2               COLOR_MAG       := $D
000000r 2               COLOR_GRAY      := $E
000000r 2               COLOR_WHITE     := $F
