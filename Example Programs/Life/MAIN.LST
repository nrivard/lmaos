000939  1               Init:
000939  1  78               SEI
00093A  1  A9 7D            LDA #<(RegisterTable)
00093C  1  A2 0C            LDX #>(RegisterTable)
00093E  1  20 77 C0         JSR VDPInit
000941  1  20 91 C0         JSR VDPClearVRAM
000944  1  20 AD C0         JSR VDPCopyDefaultCharset                   ; use default charset and overwrite $0 and $1 patterns
000947  1  A9 00 8D 81      VDPInitTable PatternTable, PatternsStart, PatternsEnd
00094B  1  BF A9 40 8D  
00094F  1  81 BF A9 05  
000964  1  A9 00 8D 81      VDPInitTable FrameBufA, NamesStart, NamesEnd
000968  1  BF A9 70 8D  
00096C  1  81 BF A9 15  
000981  1  A9 00 8D 81      VDPInitTable FrameBufB, NamesStart, NamesEnd
000985  1  BF A9 74 8D  
000989  1  81 BF A9 15  
00099E  1  A9 00 8D 81      VDPInitTable ColorTable, ColorsStart, ColorsEnd
0009A2  1  BF A9 54 8D  
0009A6  1  81 BF A9 15  
0009BB  1  A9 00 8D 81      VDPInitTable SpriteAttributes, SpriteAttrs, SpriteAttrsEnd  ; turn sprites off
0009BF  1  BF A9 48 8D  
0009C3  1  81 BF A9 35  
0009D8  1  20 EF 0B         JSR GameInit
0009DB  1               @SetupIRQ:
0009DB  1  A9 00 8D C5      DUART_IRQ_DISABLE                           ; turn off timer interrupts, we are going to use VDP frames instead
0009DF  1  BF           
0009E0  1  A5 ED 8D 03      COPY16 InterruptVector, SystemInterrupt     ; preserve old value of the interrupt vector
0009E4  1  06 A5 EE 8D  
0009E8  1  04 06        
0009EA  1  A9 AD 85 ED      COPYADDR FrameInterrupt, InterruptVector
0009EE  1  A9 0B 85 EE  
0009F2  1  A9 14            LDA #FRAMES_PER_GEN                         ; setup our frame counter
0009F4  1  85 A3            STA FrameCount
0009F6  1               @EnableDisplay:
0009F6  1  2C 81 BF         BIT VDP_BASE+REGISTERS                      ; clear INT line
0009F9  1  A9 E0 8D 81      VDPRegisterSet CONTROL_2, (CONTROL_2_VRAM_16K | CONTROL_2_DISP_EN | CONTROL_2_INT_EN | CONTROL_2_MODE_GFX_1)
0009FD  1  BF EA EA EA  
000A01  1  EA A9 81 8D  
000A0B  1  58               CLI
000A0C  1               @StartGame:
000A0C  1  20 48 0A         JSR GameLoop
000A0F  1               @RestoreIRQ:
000A0F  1  78               SEI
000A10  1  2C 81 BF         BIT VDP_BASE+REGISTERS                      ; clear INT line
000A13  1  A9 00 8D 81      VDPRegisterSet CONTROL_1, (CONTROL_1_MODE_TEXT)
000A17  1  BF EA EA EA  
000A1B  1  EA A9 80 8D  
000A25  1  A9 90 8D 81      VDPRegisterSet CONTROL_2, (CONTROL_2_VRAM_16K | CONTROL_2_MODE_TEXT)    ; turn off INTs and display
000A29  1  BF EA EA EA  
000A2D  1  EA A9 81 8D  
000A37  1  AD 03 06 85      COPY16 SystemInterrupt, InterruptVector
000A3B  1  ED AD 04 06  
000A3F  1  85 EE        
000A41  1  A9 08 8D C5      DUART_IRQ_ENABLE
000A45  1  BF           
000A46  1  58               CLI
000A47  1               @Done:
000A47  1  60               RTS
000A48  1               
000A48  1               GameLoop:
000A48  1  78               SEI
000A49  1  38 AD C1 BF      DUART_BYTE_AVAIL
000A4D  1  89 01 F0 01  
000A51  1  18           
000A52  1  B0 07            BCS @AdvanceGame
000A54  1  20 3B C0         JSR SerialGetByte
000A57  1  C9 1B            CMP #(ASCII_ESCAPE)
000A59  1  F0 19            BEQ @Done
000A5B  1               @AdvanceGame:
000A5B  1  58               CLI
000A5C  1  20 76 0A         JSR CalculateGeneration
000A5F  1               @NextGen:
000A5F  1  E6 A0 D0 02      INC16 Gens
000A63  1  E6 A1        
000A65  1  20 19 0B         JSR CopyBoardToFrameBuffer
000A68  1  20 68 0B         JSR CopyGenTextToFrameBuffer
000A6B  1  64 A4            STZ CalcNextGen
000A6D  1               @WaitLoop:
000A6D  1  CB               WAI
000A6E  1  A5 A4            LDA CalcNextGen
000A70  1  F0 FB            BEQ @WaitLoop
000A72  1  80 D4            BRA GameLoop
000A74  1               @Done:
000A74  1  58               CLI
000A75  1  60               RTS
000A76  1               
000A76  1               CalculateGeneration:
000A76  1  A5 A2            LDA BoardCurr
000A78  1  F0 12            BEQ @BoardB
000A7A  1               @BoardA:
000A7A  1  A9 00 85 00      COPYADDR (BoardB+35+CELL_OFFSET), r0    ; source
000A7E  1  A9 90 85 01  
000A82  1  A9 00 85 02      COPYADDR (BoardA+35+CELL_OFFSET), r1    ; destination
000A86  1  A9 80 85 03  
000A8A  1  80 10            BRA @Calc
000A8C  1               @BoardB:
000A8C  1  A9 00 85 00      COPYADDR (BoardA+35+CELL_OFFSET), r0    ; source
000A90  1  A9 80 85 01  
000A94  1  A9 00 85 02      COPYADDR (BoardB+35+CELL_OFFSET), r1    ; destination
000A98  1  A9 90 85 03  
000A9C  1               @Calc:
000A9C  1  A2 16            LDX #22
000A9E  1               @CalcLoopStart:
000A9E  1  A0 00            LDY #0
000AA0  1               @CalcLoop:
000AA0  1  5A               PHY                         ; cache current Y index as we need Y indexing
000AA1  1  DA               PHX                         ; cache current X index as we need
000AA2  1  18               CLC
000AA3  1  A9 00            LDA #0                      ; num of alive neighbors
000AA5  1  A0 00            LDY #NW                     ; not strictly needed, we can drop indexing for first corner
000AA7  1  71 00            ADC (r0), Y
000AA9  1  A0 01            LDY #N
000AAB  1  71 00            ADC (r0), Y
000AAD  1  A0 02            LDY #NE
000AAF  1  71 00            ADC (r0), Y
000AB1  1  A0 24            LDY #E
000AB3  1  71 00            ADC (r0), Y
000AB5  1  A0 46            LDY #SE
000AB7  1  71 00            ADC (r0), Y
000AB9  1  A0 45            LDY #S
000ABB  1  71 00            ADC (r0), Y
000ABD  1  A0 44            LDY #SW
000ABF  1  71 00            ADC (r0), Y
000AC1  1  A0 22            LDY #W
000AC3  1  71 00            ADC (r0), Y
000AC5  1  AA               TAX                         ; store neighbors in X
000AC6  1  A0 23            LDY #C
000AC8  1  B1 00            LDA (r0), Y
000ACA  1  F0 10            BEQ @Dead
000ACC  1               @Alive:
000ACC  1  E0 02            CPX #2                      ; alive neighbors < 2?
000ACE  1  90 06            BCC @Died
000AD0  1  E0 04            CPX #4                      ; alive neighbors >= 4?
000AD2  1  B0 02            BCS @Died
000AD4  1  80 10            BRA @Unchanged
000AD6  1               @Died:
000AD6  1  A9 00            LDA #0
000AD8  1  91 02            STA (r1), Y                 ; died of loneliness or overcrowding :(
000ADA  1  80 0C            BRA @Next
000ADC  1               @Dead:
000ADC  1  E0 03            CPX #3                      ; if dead and exactly 3 neighbors, we're born
000ADE  1  D0 06            BNE @Unchanged
000AE0  1  A9 01            LDA #1
000AE2  1  91 02            STA (r1), Y                 ; born in new board
000AE4  1  80 02            BRA @Next
000AE6  1               @Unchanged:
000AE6  1  91 02            STA (r1), Y                 ; store current state into new board
000AE8  1               @Next:
000AE8  1  E6 00 D0 02      INC16 r0
000AEC  1  E6 01        
000AEE  1  E6 02 D0 02      INC16 r1
000AF2  1  E6 03        
000AF4  1  FA               PLX
000AF5  1  7A               PLY
000AF6  1  C8               INY
000AF7  1  C0 20            CPY #32
000AF9  1  D0 A5            BNE @CalcLoop
000AFB  1  18 A5 00 69      ADD16 r0, 2                 ; add 2 to get base ptr for next row
000AFF  1  02 85 00 A5  
000B03  1  01 69 00 85  
000B08  1  18 A5 02 69      ADD16 r1, 2
000B0C  1  02 85 02 A5  
000B10  1  03 69 00 85  
000B15  1  CA               DEX
000B16  1  D0 86            BNE @CalcLoopStart
000B18  1               @Done:
000B18  1  60               RTS
000B19  1               
000B19  1               CopyBoardToFrameBuffer:
000B19  1  A5 A2            LDA BoardCurr
000B1B  1  F0 14            BEQ @FrameBfrB
000B1D  1  A9 20 8D 81      VDPVramAddrSet FrameBufA+32, 1
000B21  1  BF A9 70 8D  
000B25  1  81 BF        
000B27  1  A9 23 85 00      COPYADDR (BoardA+35), r0    ; skip entire top row (34) + 1st cell (border)
000B2B  1  A9 80 85 01  
000B2F  1  80 15            BRA @CopyFB
000B31  1               @FrameBfrB:
000B31  1  A9 20 8D 81      VDPVramAddrSet FrameBufB+32, 1
000B35  1  BF A9 74 8D  
000B39  1  81 BF        
000B3B  1  A9 23 85 00      COPYADDR (BoardB+35), r0    ; skip entire top row (34) + 1st cell (border)
000B3F  1  A9 90 85 01  
000B43  1  20 CB C0         JSR VDPWaitLong
000B46  1               @CopyFB:
000B46  1  A2 16            LDX #22                     ; 22 rows of data
000B48  1               @CopyFBLoopStart:
000B48  1  A0 00            LDY #0
000B4A  1               @CopyFBLoop:
000B4A  1  B1 00            LDA (r0), Y
000B4C  1  8D 80 BF         STA VDP_BASE+VRAM
000B4F  1  20 CB C0         JSR VDPWaitLong
000B52  1  C8               INY
000B53  1  C0 20            CPY #32                     ; end of data on this row?
000B55  1  D0 F3            BNE @CopyFBLoop
000B57  1  18 A5 00 69      ADD16 r0, 34                ; add full row to our pointer
000B5B  1  22 85 00 A5  
000B5F  1  01 69 00 85  
000B64  1  CA               DEX
000B65  1  D0 E1            BNE @CopyFBLoopStart
000B67  1               @Done:
000B67  1  60               RTS
000B68  1               
000B68  1               CopyGenTextToFrameBuffer:
000B68  1  A5 A2            LDA BoardCurr
000B6A  1  F0 0C            BEQ @FrameBfrB
000B6C  1  A9 E0 8D 81      VDPVramAddrSet FrameBufA + (23 * 32), 1 ; col 0 of the 23rd row
000B70  1  BF A9 72 8D  
000B74  1  81 BF        
000B76  1  80 0A            BRA @CopyHiByte
